{
  "name": "stridevote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/free-port.mjs",
    "dev": "next dev",
    "stop": "node scripts/free-port.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
