    "voters:import-history": "tsx --env-file=.env scripts/import-voter-history.ts",
    "voters:rebuild-propensity": "tsx --env-file=.env scripts/rebuild-voter-propensity.ts",
    "households:rebuild": "tsx --env-file=.env scripts/rebuild-households.ts",
    "households:geocode-census": "tsx --env-file=.env scripts/geocode-households-census.ts",
    "households:refine-mapbox": "tsx --env-file=.env scripts/refine-households-mapbox.ts",
    "precincts:import": "tsx --env-file=.env scripts/import-precincts.ts",
