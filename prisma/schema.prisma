// StrideVote data model. Postgres via Prisma. All access through DATABASE_URL so
// the same schema runs on local Docker, AWS RDS/Aurora, Azure Database for
// PostgreSQL, or Neon with no code change.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js (NextAuth v5) core tables + StrideVote user fields ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // StrideVote profile
  firstName       String?
  lastName        String?
  phone           String? @unique
  initials        String?
  homeLat         Float?
  homeLng         Float?
  area            String?
  addressLine     String?
  city            String?
  state           String?
  postalCode      String?
  locationSource  String? // "address" | "city" | "zip" | "gps"
  isPlatformAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships CampaignMembership[]
  checkouts   ListCheckout[]
  watches     ListWatch[]
  assignedTurfs ListCampaign[] @relation("AssignedTurfs")
  savedFilters  SavedVoterFilter[]
  attempts    CanvassAttempt[]
  listSplits  ListSplit[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Channel-agnostic OTP store (phone SMS + WhatsApp). Email uses the
// Auth.js VerificationToken magic-link flow, not this table. ----
model OtpChallenge {
  id          String    @id @default(cuid())
  channel     String // "sms" | "whatsapp"
  destination String // E.164 phone number
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([destination])
}

// ---- Campaigns ----
model Campaign {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  office       String
  district     String
  website      String?
  iconUrl      String?
  tags         String[]
  color        String
  centroidLat  Float?
  centroidLng  Float?
  regionType   String? // "state" | "county" | "city" | "legislative" | "congressional"
  regionName   String?
  regionState  String?  @default("WA")
  boundary     Json? // polygon: number[][] of [lat, lng]
  pickupType   String? // "locker" | "address"
  pickupLabel  String?
  pickupAddress String?
  pickupDetail String?

  createdAt DateTime @default(now())

  contacts    CampaignContact[]
  memberships CampaignMembership[]
  listLinks   ListCampaign[]
  voterLinks  CampaignVoter[]
  savedFilters SavedVoterFilter[]
  programs    CanvassProgram[]
  attempts    CanvassAttempt[]
}

model CampaignContact {
  id         String  @id @default(cuid())
  campaignId String
  name       String
  role       String
  phone      String?
  email      String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignMembership {
  id          String    @id @default(cuid())
  userId      String
  campaignId  String
  status      String // "active" | "pending"
  roles       String[] @default(["canvasser"]) // see src/lib/roles.ts
  joinedAt    DateTime?
  requestedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

// Named canvass pass under a campaign (e.g. "2026 Primary" vs "2026 General").
// Lists are published into a program; attempts and checkouts are scoped to it.
model CanvassProgram {
  id         String    @id @default(cuid())
  campaignId String
  name       String
  status     String    @default("draft") // "draft" | "active" | "closed"
  startsAt   DateTime?
  endsAt     DateTime?
  script     String?
  // ProgramQuestion[] — yes_no | single | multi | support | text
  questions  Json      @default("[]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  campaign      Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  listLinks     ListCampaign[]
  checkouts     ListCheckout[]
  households    ProgramListHousehold[]
  voters        ProgramListVoter[]
  attempts      CanvassAttempt[]
  listSplits    ListSplit[]

  @@unique([campaignId, name])
  @@index([campaignId, status])
}

// ---- Lists (turf) sourced from external platforms ----
model List {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  source       String // "minivan" | "civibyte" | "stridevote"
  sourceRef    String? // Minivan list-number OR Civibyte URL
  doorsCount   Int     @default(0)
  centroidLat  Float?
  centroidLng  Float?
  boundary     Json? // polygon: number[][] of [lat, lng]
  data         Json    @default("{}") // split metadata and optional per-platform payload

  createdAt DateTime @default(now())

  campaignLinks ListCampaign[]
  checkouts     ListCheckout[]
  watches       ListWatch[]
  households    ListHousehold[]
  voters        ListVoter[]
  programHouseholds ProgramListHousehold[]
  programVoters     ProgramListVoter[]
  attempts          CanvassAttempt[]
  redirectsFrom     ListHouseholdRedirect[] @relation("RedirectFrom")
  redirectsTo       ListHouseholdRedirect[] @relation("RedirectTo")
  splitsAsSource    ListSplit[] @relation("SplitSource")
  splitsAsReleased  ListSplit[] @relation("SplitReleased")
}

// Per-program publish of a list into a campaign (visibility + assignee).
model ListCampaign {
  id             String  @id @default(cuid())
  listId         String
  campaignId     String
  programId      String
  visibility     String  @default("volunteers") // "volunteers" | "assigned" | "draft"
  assignedUserId String?

  list         List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  program      CanvassProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  assignedUser User?          @relation("AssignedTurfs", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([listId, campaignId, programId])
  @@index([campaignId, visibility])
  @@index([programId, visibility])
  @@index([assignedUserId])
}

// Exclusive active hold is per (listId, programId), not global on the list.
model ListCheckout {
  id            String    @id @default(cuid())
  listId        String
  programId     String
  userId        String
  status        String    @default("active") // "active" | "released" | "completed"
  checkedOutAt  DateTime  @default(now())
  releasedAt    DateTime?
  progressDone  Int       @default(0)
  progressTotal Int       @default(0)

  list    List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  program CanvassProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts CanvassAttempt[]

  @@index([listId, programId, status])
  @@index([userId, status])
  @@index([programId, status])
}

// Frozen walk order for a list inside a program (survives later turf edits).
model ProgramListHousehold {
  id          String   @id @default(cuid())
  programId   String
  listId      String
  householdId String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  program   CanvassProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  list      List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([programId, listId, householdId])
  @@index([programId, listId, sortOrder])
}

model ProgramListVoter {
  id          String   @id @default(cuid())
  programId   String
  listId      String
  voterId     String
  matchedSeed Boolean  @default(false)
  createdAt   DateTime @default(now())

  program CanvassProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  list    List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  voter   Voter          @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([programId, listId, voterId])
  @@index([programId, listId])
}

// Append-only household knock. "Current" result = latest not superseded.
model CanvassAttempt {
  id                 String   @id @default(cuid())
  clientAttemptId    String   @unique
  programId          String
  listId             String
  householdId        String
  checkoutId         String?
  userId             String
  campaignId         String
  outcome            String // contact | no_answer | refused | lit | unsafe | inaccessible | moved
  notes              String?
  capturedAt         DateTime
  supersedesClientId String?
  staleCheckout      Boolean  @default(false)
  packetVersion      String?
  createdAt          DateTime @default(now())

  program   CanvassProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  list      List                    @relation(fields: [listId], references: [id], onDelete: Cascade)
  household Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  checkout  ListCheckout?           @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign  Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  people    CanvassPersonResponse[]

  @@index([programId, listId, householdId, capturedAt])
  @@index([campaignId, programId, capturedAt])
  @@index([userId, capturedAt])
  @@index([checkoutId])
  @@index([staleCheckout])
  @@index([supersedesClientId])
}

model CanvassPersonResponse {
  id         String  @id @default(cuid())
  attemptId  String
  voterId    String
  outcome    String // talked | refused | moved | not_home
  support    Int? // 1–5
  answers    Json    @default("{}")
  notes      String?

  attempt CanvassAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  voter   Voter          @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([attemptId, voterId])
  @@index([voterId])
}

model ListWatch {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
}

// ---- Public voter-file records (restricted to political use) ----
model Voter {
  id                    String   @id @default(cuid())
  stateVoterId          String   @unique
  firstName             String
  middleName            String?
  lastName              String
  suffix                String?
  yearOfBirth           Int?
  gender                String?
  registrationAddress   String
  city                   String
  state                  String
  postalCode             String
  countyCode             String?
  precinctCode           String?
  precinctPart           String?
  legislativeDistrict   String?
  congressionalDistrict String?
  registrationDate      DateTime?
  lastVoted             DateTime? @db.Date
  electionsVoted        String[] @default([]) // denormalized cache; full history is VoterHistory
  primaryParticipation  Float?
  generalParticipation  Float?
  primaryEligible       Int?
  primaryVoted          Int?
  generalEligible       Int?
  generalVoted          Int?
  likelyPrimary         Boolean  @default(false)
  likelyGeneral         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  campaignLinks CampaignVoter[]
  history       VoterHistory[]
  householdLinks HouseholdVoter[]
  listLinks     ListVoter[]
  programLinks  ProgramListVoter[]
  personResponses CanvassPersonResponse[]

  @@index([lastName, firstName])
  @@index([precinctCode])
  @@index([legislativeDistrict])
  @@index([congressionalDistrict])
}

// One SOS ballot record. Older files (2007–2012) have no VoterHistoryID and
// use WA-prefixed voter IDs; those are stored with a normalized stateVoterId.
model VoterHistory {
  id               String    @id @default(cuid())
  sosHistoryId     String?   @unique
  stateVoterId     String
  voterId          String?
  countyCode       String?
  countyCodeVoting String?
  electionDate     DateTime  @db.Date
  electionType     String    @default("special") // general | primary | presidential_primary | special
  source           String?

  voter Voter? @relation(fields: [voterId], references: [id], onDelete: SetNull)

  @@unique([stateVoterId, electionDate])
  @@index([voterId])
  @@index([electionDate])
  @@index([electionType, electionDate])
  @@index([stateVoterId])
}

model CampaignVoter {
  id         String   @id @default(cuid())
  campaignId String
  voterId    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  voter    Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([campaignId, voterId])
  @@index([campaignId])
}

// Official election precinct boundaries, imported from a state dataset (for WA,
// the Secretary of State statewide precinct shapefile). countyCode + code join
// directly to Voter.countyCode + Voter.precinctCode, so precinct turfs can be
// counted from registration data without geocoding. The bbox columns let a
// campaign load only the precincts near its district.
model Precinct {
  id          String @id @default(cuid())
  state       String @default("WA")
  countyCode  String // "KI"
  countyName  String
  code        String // precinct code as it appears in the voter file, e.g. "2202"
  name        String
  stateCode   String? // dataset-wide id, e.g. "KI00002202"
  boundary    Json // largest outer ring as [lat, lng][]
  geometry    Json // full GeoJSON Polygon / MultiPolygon in [lng, lat]
  centroidLat Float?
  centroidLng Float?
  minLat      Float
  maxLat      Float
  minLng      Float
  maxLng      Float
  source      String // dataset label, e.g. "wa-sos-2025general"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([state, countyCode, code])
  @@index([state, countyCode])
  @@index([minLat, maxLat])
  @@index([minLng, maxLng])
}

// Campaign-shared voter directory presets. filters JSON is VoterFilters without page.
model SavedVoterFilter {
  id          String   @id @default(cuid())
  campaignId  String
  createdById String?
  name        String
  filters     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([campaignId, name])
  @@index([campaignId])
}

// One physical door / mailing address. A single lat/lng is the persistent pin;
// geocodeSource records where it came from (census | county | mapbox).
model Household {
  id               String   @id @default(cuid())
  normalizedKey    String   @unique
  displayAddress   String
  addressLine      String
  city             String
  state            String
  postalCode       String
  unit             String?
  lat              Float?
  lng              Float?
  geocodeSource    String?  // census | county | mapbox
  geocodeRef       String?  // source-specific id when available
  geocodeStatus    String   @default("pending") // pending | matched | unmatched | ambiguous (Census pipeline)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  voters HouseholdVoter[]
  lists  ListHousehold[]
  programLists ProgramListHousehold[]
  attempts     CanvassAttempt[]
  redirects    ListHouseholdRedirect[]

  @@index([geocodeStatus])
  @@index([geocodeSource])
  @@index([lat, lng])
}

// Maps a household that left a list during a volunteer split so stale offline
// packets (still keyed by the old listId) can sync onto the child list.
model ListHouseholdRedirect {
  id          String   @id @default(cuid())
  fromListId  String
  householdId String
  toListId    String
  createdAt   DateTime @default(now())

  fromList  List      @relation("RedirectFrom", fields: [fromListId], references: [id], onDelete: Cascade)
  toList    List      @relation("RedirectTo", fields: [toListId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([fromListId, householdId])
  @@index([toListId])
  @@index([householdId])
}

// Audit row for each volunteer geographic split.
model ListSplit {
  id             String   @id @default(cuid())
  sourceListId   String
  releasedListId String
  programId      String
  userId         String
  keptHalfKey    String // "a" | "b"
  axis           String // "lat" | "lng"
  createdAt      DateTime @default(now())

  sourceList   List           @relation("SplitSource", fields: [sourceListId], references: [id], onDelete: Cascade)
  releasedList List           @relation("SplitReleased", fields: [releasedListId], references: [id], onDelete: Cascade)
  program      CanvassProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sourceListId])
  @@index([releasedListId])
  @@index([programId])
  @@index([userId])
}

model HouseholdVoter {
  id          String   @id @default(cuid())
  householdId String
  voterId     String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  voter     Voter     @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([voterId])
  @@index([householdId])
}

model ListHousehold {
  id          String   @id @default(cuid())
  listId      String
  householdId String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  list      List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([listId, householdId])
  @@index([listId, sortOrder])
}

model ListVoter {
  id         String   @id @default(cuid())
  listId     String
  voterId    String
  matchedSeed Boolean @default(false)
  createdAt  DateTime @default(now())

  list  List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  voter Voter @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([listId, voterId])
  @@index([listId])
  @@index([voterId])
}
