# ---- StrideVote environment (cloud-agnostic) ----
# Copy to .env for local dev. Every deploy target (AWS/Azure/local) is configured
# purely through these variables; no cloud SDKs are baked into the app.

# Postgres. Works with local Docker, AWS RDS/Aurora, Azure DB for PostgreSQL, Neon.
DATABASE_URL="postgresql://stridevote:stridevote@localhost:5432/stridevote?schema=public"

# Auth.js. Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="dev-only-secret-change-me"
AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"

# Active auth delivery channels (comma-separated): email | sms | whatsapp
# Email magic link is the day-one primary. SMS/WhatsApp are stubbed until a
# sender number is leased + registered (see README).
AUTH_CHANNELS="email"

# Platform super-admins (comma-separated emails). These users can create
# campaigns and administer every campaign, in addition to anyone whose
# User.isPlatformAdmin flag is set in the database.
PLATFORM_ADMIN_EMAILS="halih@hotmail.com"

# ---- Email delivery (magic link) ----
# Leave both unset in dev: the link is printed to the server console and shown
# on the login screen. Set ONE of these for real delivery.
# RESEND_API_KEY=""
# EMAIL_FROM="StrideVote <login@stride.vote>"
# SMTP_URL="smtp://user:pass@smtp.example.com:587"

# ---- Map tiles (optional; defaults to public OpenStreetMap) ----
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# ---- Household geocoding ----
# Census batch geocoding is free and needs no key (npm run households:geocode-census).
# Mapbox is used only when generating lists/turfs to refine door points.
# Permanent geocoding must be enabled on the token to STORE mapboxLat/mapboxLng
# (adapter sends permanent=true). Temporary results cannot legally be persisted.
# MAPBOX_ACCESS_TOKEN=""
